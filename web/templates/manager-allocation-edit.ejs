<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit Allocation | Resource Planner</title>
    <link rel="stylesheet" href="/static/style.css">
</head>

<body data-theme="light">
<% const adminSuffix = isAdminView ? "?admin_view=1" : ""; %>

<div class="layout">

    <% if (!isAdminView) { %>
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <span class="sidebar-logo">R8</span>
            <button class="sidebar-toggle" onclick="toggleSidebar()">☰</button>
        </div>

        <nav class="sidebar-nav">
            <a href="/manager/dashboard" class="nav-link">📊 <span class="nav-text">Dashboard</span></a>
            <a href="/manager/projects" class="nav-link">📁 <span class="nav-text">Projects</span></a>
            <a href="/manager/availability" class="nav-link">📅 <span class="nav-text">Availability</span></a>
            <a href="/manager/allocation" class="nav-link active">📦 <span class="nav-text">Allocation</span></a>
            <a href="/manager/team" class="nav-link">👥 <span class="nav-text">Team</span></a>
            <a href="/manager/bookings" class="nav-link">🗂 <span class="nav-text">Bookings</span></a>
            <a href="/logout" class="nav-link logout-link">Logout</a>
        </nav>
    </aside>
    <% } %>

    <main class="content">

        <div class="page-header">
            <div>
                <p class="r8-section-title">Resource Allocation</p>
                <h2 class="r8-page-title">Edit Allocation</h2>
            </div>
            <a class="secondary-link" href="/manager/allocation<%= adminSuffix %>">Back to Allocation</a>
        </div>

        <p class="subtitle">Reassign this entry to a different person or project, and adjust dates and hours.</p>

        <% if (error) { %>
            <div class="error-box"><%= error %></div>
        <% } %>

        <% if (message) { %>
            <div class="success-box"><%= message %></div>
        <% } %>

        <div class="dashboard-card allocation-edit-card">
            <div class="allocation-summary">
                <div class="allocation-summary-item">
                    <span class="allocation-summary-label">Current team member</span>
                    <strong><%= assignment.user_name %></strong>
                </div>
                <div class="allocation-summary-item">
                    <span class="allocation-summary-label">Current project</span>
                    <strong><%= assignment.project_code %> - <%= assignment.project_name %></strong>
                </div>
            </div>

            <form method="POST" action="/manager/allocation/<%= assignment.id %>/edit<%= adminSuffix %>" class="allocation-edit-form">
                <div class="allocation-form-grid">
                    <div class="input-group">
                        <label>Team Member</label>
                        <select name="user_id" class="role-select" required>
                            <% teamMembers.forEach(member => { %>
                                <option value="<%= member.id %>" <%= assignment.user_id === member.id ? 'selected' : '' %>>
                                    <%= member.name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="input-group">
                        <label>Project</label>
                        <select name="project_id" class="role-select" required>
                            <% projects.forEach(project => { %>
                                <option value="<%= project.id %>" <%= assignment.project_id === project.id ? 'selected' : '' %>>
                                    <%= project.project_code %> - <%= project.project_name %>
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="input-group">
                        <label>Start Date</label>
                        <input type="date" name="start_date" value="<%= assignment.start_date %>" required>
                    </div>

                    <div class="input-group">
                        <label>End Date</label>
                        <input type="date" name="end_date" value="<%= assignment.end_date %>" required>
                    </div>

                    <div class="input-group input-group-wide">
                        <label>Hours Per Week</label>
                        <input
                            type="number"
                            name="hours_per_week"
                            min="1"
                            step="0.5"
                            value="<%= assignment.hours_per_week %>"
                            required
                        >
                    </div>
                </div>

                <div class="form-actions">
                    <button class="login-btn small-btn" type="submit">Save Changes</button>
                    <a class="secondary-btn" href="/manager/allocation<%= adminSuffix %>">Cancel</a>
                </div>
            </form>
        </div>

    </main>

</div>

<script src="/static/logout-modal.js"></script>
<script>
function toggleSidebar() {
    const s = document.getElementById("sidebar");
    if (!s) return;
    s.classList.toggle("collapsed");
    localStorage.setItem("sidebar-collapsed", s.classList.contains("collapsed"));
}

document.addEventListener("DOMContentLoaded", () => {
    const sidebar = document.getElementById("sidebar");
    if (sidebar && localStorage.getItem("sidebar-collapsed") === "true") {
        sidebar.classList.add("collapsed");
    }

    const saved = localStorage.getItem("theme");
    if (saved) {
        document.documentElement.setAttribute("data-theme", saved);
    }
});
</script>

</body>
</html>
